# Copy to .env.local for local configuration; do not commit .env.local.
WEBSITE_HOST=127.0.0.1
WEBSITE_PORT=4328
DEMO_DB_PATH=.local-data/demo.sqlite
DEMO_RETENTION_DAYS=90
# Production requires NODE_ENV=production and the public origin below.
# DEMO_SITE_URL=https://vane.astrovela.ai
# RESEND_API_KEY=
# DEMO_FROM=demo@your-verified-domain.example
# DEMO_TO=pulse@astrovela.ai
# DEMO_RATE_LIMIT_SECRET=
# Set only behind a trusted loopback reverse proxy which overwrites X-Real-IP.
# DEMO_TRUST_PROXY=1
