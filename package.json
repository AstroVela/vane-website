{
  "name": "vane-site",
  "private": true,
  "version": "0.0.0",
  "description": "Vane Context commercial multimodal service and Vane Data open source engine website.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:en": "docusaurus start",
    "dev:zh-CN": "docusaurus start --locale zh-CN",
    "build": "docusaurus build && node scripts/compress-assets.mjs",
    "test": "node --test tests/*.test.mjs",
    "docs:lint": "node scripts/docs-lint.mjs",
    "docs:llms": "node scripts/docs-llms.mjs",
    "docs:llms:check": "node scripts/docs-llms.mjs --check",
    "docs:manifest": "node scripts/docs-manifest.mjs",
    "docs:manifest:check": "node scripts/docs-manifest.mjs --check",
    "enterprise:content:check": "node scripts/enterprise-use-case-check.mjs",
    "home:content:check": "node scripts/home-content-check.mjs",
    "training:content:check": "node scripts/training-use-case-check.mjs",
    "solutions:content:check": "node scripts/solutions-content-check.mjs",
    "write-translations": "docusaurus write-translations --locale zh-CN",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build && npm run preview:local",
    "docs:context": "node scripts/context-docs.mjs",
    "docs:context:check": "node scripts/context-docs.mjs --check",
    "showcase:check": "node scripts/showcase-check.mjs",
    "test:browser": "playwright test",
    "preview:local": "node --env-file-if-exists=.env.local server/start.ts",
    "start": "node --env-file-if-exists=.env.local server/start.ts",
    "deploy:static": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-content-blog": "^3.10.1",
    "@docusaurus/plugin-content-docs": "^3.10.1",
    "@docusaurus/plugin-sitemap": "^3.10.1",
    "@docusaurus/theme-classic": "^3.10.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-icons": "^1.3.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@eslint/js": "^10.0.1",
    "@mdx-js/react": "^3.1.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "wrangler": "^4.112.0"
  },
  "engines": {
    "node": ">=24"
  }
}
